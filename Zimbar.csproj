<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TFM com versão do Windows: dá acesso ao Windows.Media.Control (player nativo) -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Zimbar</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Zimbar</Product>
    <Description>Cinto de ferramentas do Pedro — barra rápida com hotkey global.</Description>
    <ApplicationIcon>assets\Zimbar.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- publicação limpa: só o exe e a pasta ui -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- WinForms + WPF juntos colidem em Application/Point etc. (mesmo padrão do Relâmpago) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Logos: embutidos como recurso (janelas) e ao lado do exe (bandeja) -->
  <ItemGroup>
    <Resource Include="assets\Zimbar.png" />
    <Resource Include="assets\ZimNotes.png" />
    <Resource Include="assets\Zimbar.ico" />
    <Resource Include="assets\ZimNotes.ico" />
  </ItemGroup>

  <!-- Fontes do Acervo embutidas: Archivo Black (display) + Space Grotesk (corpo, Regular+Bold) -->
  <ItemGroup>
    <Resource Include="assets\fonts\ArchivoBlack-Regular.ttf" />
    <Resource Include="assets\fonts\SpaceGrotesk-Regular.ttf" />
    <Resource Include="assets\fonts\SpaceGrotesk-Bold.ttf" />
  </ItemGroup>

  <!-- A interface roda num WebView2 (runtime já vem no Windows 11) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- ui/ vai junto do executável: é a interface inteira -->
  <ItemGroup>
    <None Include="ui\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="_antigo\**" />
    <Compile Remove="_antigo\**" />
    <Page Remove="_antigo\**" />
  </ItemGroup>

</Project>
