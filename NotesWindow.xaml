<Window x:Class="Zimbar.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ZimNotes"
        Icon="assets/ZimNotes.png"
        Width="360" Height="560"
        MinWidth="300" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality">

    <!-- O mesmo painel "Minhas notas" que aparece embutido no Zimbar, só que
         solto: puxou pra fora, virou esta janela. Papel claro, cantos macios. -->
    <Window.Resources>
        <Style x:Key="Redondo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3A3F49"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8"
                                Width="26" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E7EAF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="18" Padding="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                    <GradientStop Color="#F3F4F8" Offset="0"/>
                    <GradientStop Color="#E7EAF0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Opacity="0.18" Color="#161B2C"/>
            </Border.Effect>

            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- barra: título à esquerda, + e × à direita; arrasta a janela -->
                <DockPanel Grid.Row="0" Margin="2,0,0,10" Background="Transparent"
                           Cursor="SizeAll" MouseLeftButtonDown="Header_MouseDown"
                           ToolTip="arrasta pra mover a janela">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Redondo}" Click="New_Click" Content="＋" ToolTip="nova nota"/>
                        <Button Style="{StaticResource Redondo}" Click="CloseWin_Click" Content="✕" ToolTip="fechar"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✎" FontSize="13" Foreground="#858C99" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Minhas notas" FontSize="14.5" FontWeight="Bold" Foreground="#14161B"/>
                        <TextBlock x:Name="CountText" Text="" FontSize="11" Foreground="#A8AEB9"
                                   VerticalAlignment="Center" Margin="9,1,0,0"/>
                        <TextBlock x:Name="StatusText" Text="" FontSize="11" Foreground="#CB4F2F"
                                   VerticalAlignment="Center" Margin="8,1,0,0"/>
                    </StackPanel>
                </DockPanel>

                <!-- categorias (pastas), iguais às do painel embutido -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                    <StackPanel x:Name="ChipsPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <primitives:Thumb x:Name="ResizeThumb"
                          Width="24" Height="24"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,6,6" Cursor="SizeNWSE"
                          DragDelta="ResizeThumb_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Opacity="0.35" Background="Transparent">
                        <Path Stroke="#14161B" StrokeThickness="1.6" StrokeEndLineCap="Round"
                              Data="M 14,20 L 20,14 M 9,20 L 20,9"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
