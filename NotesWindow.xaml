<Window x:Class="Zimbar.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZimNotes"
        Icon="assets/ZimNotes.png"
        Width="1060" Height="700"
        MinWidth="720" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F3F4F8"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- A janela é a MESMA interface que a aba Notas do Zimbar usa: notas.html
         carrega notas.css e notas.js, os mesmos arquivos. Não tem duas versões
         do ZimNotes pra manter em dia — tem uma, em dois lugares. -->
    <wv2:WebView2 x:Name="Web"/>
</Window>
