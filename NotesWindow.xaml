<Window x:Class="Zimbar.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ZimNotes"
        Icon="assets/ZimNotes.png"
        Width="360" Height="560"
        MinWidth="280" MinHeight="340"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#f8f6f1"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- A janela solta é o MESMO painel do Zimbar embutido: notas.html carrega
         notas.css + notas.js, os mesmos cards e chips. Igual, não parecido. -->
    <wv2:WebView2 x:Name="Web"/>
</Window>
