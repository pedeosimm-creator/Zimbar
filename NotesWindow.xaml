<Window x:Class="Zimbar.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="ZimNotes"
        Icon="assets/ZimNotes.png"
        Width="430" Height="640"
        MinWidth="330" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        RenderOptions.BitmapScalingMode="HighQuality">

    <!-- Mesmo desenho do ZimNotes de celular: papel claro, cantos macios,
         sombra larga. Sem depender do dicionario antigo do Zimbar. -->
    <Window.Resources>
        <Style x:Key="Redondo" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3A3F49"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#FFFFFF" CornerRadius="16"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#F0F2F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Escuro" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F3F4F8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#14161B" CornerRadius="16" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2E37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Busca" TargetType="TextBox">
            <Setter Property="Foreground" Value="#14161B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#14161B"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFFFFF" CornerRadius="15" Padding="14,10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border CornerRadius="20" Padding="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                    <GradientStop Color="#F3F4F8" Offset="0"/>
                    <GradientStop Color="#E7EAF0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270"
                                  Opacity="0.18" Color="#161B2C"/>
            </Border.Effect>

            <Grid Margin="18,16,18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14" Background="Transparent"
                           Cursor="SizeAll" MouseLeftButtonDown="Header_MouseDown"
                           ToolTip="arrasta aqui pra mover a janela">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Escuro}" Click="New_Click" Content="+ nota"/>
                        <Button Style="{StaticResource Redondo}" Click="CloseWin_Click" Content="✕" Margin="8,0,0,0"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Suas notas" FontSize="21" FontWeight="Bold"
                                   Foreground="#14161B"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="CountText" Text="" FontSize="11.5" Foreground="#858C99"/>
                            <TextBlock x:Name="StatusText" Text="" FontSize="11.5"
                                       Foreground="#CB4F2F" Margin="9,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <TextBox x:Name="SearchBox" Grid.Row="1"
                         Style="{StaticResource Busca}"
                         TextChanged="SearchBox_TextChanged"
                         Margin="0,0,0,14"
                         ToolTip="buscar notas (Ctrl+F)"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NotesListPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <primitives:Thumb x:Name="ResizeThumb"
                          Width="24" Height="24"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,6,6" Cursor="SizeNWSE"
                          DragDelta="ResizeThumb_DragDelta">
            <primitives:Thumb.Template>
                <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                    <Grid Opacity="0.35" Background="Transparent">
                        <Path Stroke="#14161B" StrokeThickness="1.6" StrokeEndLineCap="Round"
                              Data="M 14,20 L 20,14 M 9,20 L 20,9"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>
                </ControlTemplate>
            </primitives:Thumb.Template>
        </primitives:Thumb>
    </Grid>
</Window>
