<Window x:Class="Zimbar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Zimbar"
        Icon="assets/Zimbar.png"
        Width="1340" Height="860" MinWidth="900" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#F8F6F1"
        Topmost="False" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">

    <!-- Sem barra de titulo do Windows, mas com redimensionar nativo pelas bordas.
         Quem desenha o cabecalho e a propria interface. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#15171C"/>
</Window>
